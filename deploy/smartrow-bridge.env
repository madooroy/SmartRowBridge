# /etc/default/smartrow-bridge
# Everything is optional: with all values empty the bridge finds its radios and the
# pulley by itself. Restart after a change: sudo systemctl restart smartrow-bridge

# Which radio does what. Empty = chosen by type: the built-in radio talks to the
# pulley, the USB dongle hosts the virtual devices. hci0/hci1 numbering can swap
# between boots, so to pin them use the radios' MACs (tools/check_adapters.py shows
# them), e.g. SRB_CENTRAL_MAC=D8:3A:DD:11:22:33
SRB_CENTRAL_MAC=
SRB_PERIPHERAL_MAC=
# Leave these empty; setting hciN here overrides the MAC pins.
SRB_CENTRAL_ADAPTER=
SRB_PERIPHERAL_ADAPTER=

# Which pulley to connect to. Empty (default) = the first device advertising the
# SmartRow service (0x1234) or named SmartRow, so a replacement pulley just works.
# Set a MAC, e.g. D1:2C:3B:4A:5F:60, only where several SmartRows are in range
# (it is in the log: journalctl -u smartrow-bridge | grep "Connected to pulley").
SRB_PULLEY_ADDRESS=
SRB_PULLEY_NAME=SmartRow

# The two virtual devices on the dongle.
# Pulley clone for the SmartRow app (name defaults to the real pulley's, "SmartRow"):
# Leave it empty: a test with another name (SmartRowPi) did not work with the SmartRow app.
SRB_CLONE_NAME=
# Generic FTMS rower for Peloton and other fitness apps - never called SmartRow:
SRB_FITNESS_NAME=PiRower
# Their Bluetooth addresses. Empty = derived from the dongle's MAC: the same on every
# boot (so the apps recognise the devices they paired with) and unique to this Pi.
# To set them by hand use static random addresses (first byte C0-FF), different
# from each other, e.g. F2:53:52:4F:57:31
SRB_CLONE_ADDRESS=
SRB_FITNESS_ADDRESS=

# Test only: 0 = advertise the pulley clone WITHOUT the pulley ID (manufacturer data),
# to see whether the SmartRow app accepts a device that cannot send it (e.g. an iPhone).
# Give SRB_CLONE_ADDRESS a new value for the test, or the app just reconnects to the
# address it already knows.
SRB_ADVERTISE_PULLEY_ID=1

# 1 = the bridge initialises/polls the pulley itself while the SmartRow app is not connected.
SRB_DRIVE_WITHOUT_TABLET=1

# Milestone record that survives shutdown (read by tools/health_check.sh); "off" disables.
SRB_SESSION_LOG=

# Status file for the optional screen (tools/setup_display.sh), rewritten every second
# in RAM. Empty = /run/smartrow-bridge/status.json; "off" disables.
SRB_STATUS_FILE=
# Interval coach (experimental): finds harder efforts by itself and shows force-curve
# feedback on the screen and the web page. 1 turns it on (needs the status file).
SRB_COACH=0
# Coach tuning (empty = default): an interval is at least START_PCT % above your steady
# power (20); efforts longer than MAX_MIN minutes count as a new steady pace (5);
# SENSITIVITY low / normal / high: how readily the technique cues speak up (normal).
SRB_COACH_START_PCT=
SRB_COACH_MAX_MIN=
SRB_COACH_SENSITIVITY=
# Your rowing FTP in watts. With it, an effort must also reach 65 % of it (so a warm-up
# can't pass for one) and may last up to 20 minutes. Empty = read it from intervals.icu
# (Settings, Rowing) when that is set up; "off" = don't use one.
SRB_COACH_FTP=
# Coach: each session's summary is saved here for the web page (newest 60 kept).
# Empty = /var/lib/smartrow-bridge/sessions; "off" disables.
SRB_SESSION_DIR=
# Heart rate strap read by the bridge itself (for the coach, the session summaries and the
# fitness app): off, auto (the first strap advertising heart rate), a MAC address, or part
# of its name, e.g. COROS. Straps that take several connections can stay paired elsewhere.
SRB_HEART_RATE=off
# 0 = don't pass that heart rate on to the fitness app (PiRower).
SRB_HEART_RATE_TO_FITNESS=1
# Uploads (tools/setup_intervals.sh, tools/setup_strava.sh). intervals.icu: activity (the
# session as an activity, replacing the copy that comes from Strava), note (a calendar note
# instead) or off. Strava activity type: Rowing or VirtualRow.
SRB_INTERVALS_UPLOAD=activity
SRB_STRAVA_SPORT_TYPE=Rowing
# Web page only (tools/setup_web.sh): port it is served on.
SRB_WEB_PORT=8080
# Screen only: 0 = leave the RGB LED off; seconds to hold button A to switch the Pi off.
SRB_DISPLAY_LED=1
SRB_DISPLAY_HOLD_S=2

# Debugging: raw packet capture and log verbosity (DEBUG, INFO, WARNING).
SRB_SNIFF_LOG=
# 1 = also log every GATT request the apps make (verbose; for diagnosing an app that will not connect)
SRB_GATT_LOG=
SRB_LOG_LEVEL=INFO
